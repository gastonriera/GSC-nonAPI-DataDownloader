{
  "manifest_version": 3,
  "name": "GSC non-API Data Downloader",
  "version": "2.1.1",
  "description": "1-Click automated native export (Excel/CSV) of Google Search Console reports and all drilldowns: Page Indexing, Crawl Stats, and Core Web Vitals.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GSC non-API Data Downloader"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://search.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://search.google.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/page-injected.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
